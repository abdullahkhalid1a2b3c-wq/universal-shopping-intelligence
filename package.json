{
  "name": "fitsense",
  "private": true,
  "scripts": {
    "dev:web": "cd apps/web && pnpm dev",
    "dev:api": "cd apps/api && .venv\\Scripts\\uvicorn app.main:app --reload --port 8000",
    "build:extension": "cd apps/extension && pnpm build",
    "test:web": "node --experimental-strip-types --test apps/web/tests/utils.test.ts apps/web/tests/onboarding.test.ts",
    "test:api": "cd apps/api && .venv\\Scripts\\python -m pytest",
    "test:extension": "node --experimental-strip-types --test apps/extension/tests/url.test.ts apps/extension/tests/detector.test.ts apps/extension/tests/widget.test.ts apps/extension/tests/auth.test.ts",
    "release:extension": "node apps/extension/scripts/release.js",
    "smoke:test": "python scripts/smoke_test.py",
    "scan:secrets": "node scripts/scan-secrets.js"
  },
  "devDependencies": {
    "supabase": "^3.0.0"
  }
}
